# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

org_prefix = "dil"
location   = "uksouth"

# Single-subscription lab: set only this one.
management_subscription_id = "00000000-0000-0000-0000-000000000000"

# Multi-subscription (real-world) layout:
# connectivity_subscription_id = "11111111-1111-1111-1111-111111111111"
# landingzone_subscription_id  = "22222222-2222-2222-2222-222222222222"

# Move subscriptions into the hierarchy (optional).
# In a one-sub lab, "corp" makes the landing zone policies apply to it.
# subscription_placement = {
#   "00000000-0000-0000-0000-000000000000" = "corp"
# }

# Audit only to begin with. Set true once you've checked compliance.
policy_enforce = false

# Costly extras - leave off unless labbing them, then destroy.
deploy_firewall = false
enable_defender = false

spokes = {
  corp-app1 = {
    address_space = "10.1.0.0/24"
    subnets = {
      snet-web  = "10.1.0.0/26"
      snet-app  = "10.1.0.64/26"
      snet-data = "10.1.0.128/26"
    }
  }
  corp-app2 = {
    address_space = "10.2.0.0/24"
    subnets = {
      snet-app = "10.2.0.0/26"
    }
  }
}

# rbac_assignments = {
#   platform-owners = { management_group = "platform", role = "Owner",  principal_id = "<entra-group-object-id>" }
#   all-readers     = { management_group = "root",     role = "Reader", principal_id = "<entra-group-object-id>" }
# }
